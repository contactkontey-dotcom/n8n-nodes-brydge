{
  "name": "n8n-nodes-brydge",
  "version": "0.1.1",
  "description": "n8n community node for BRYDGE: ask before an agent acts, then check against the destination's own records whether the work happened.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "brydge",
    "verification",
    "agents",
    "supervision"
  ],
  "homepage": "https://github.com/contactkontey-dotcom/n8n-nodes-brydge#readme",
  "bugs": {
    "url": "https://github.com/contactkontey-dotcom/n8n-nodes-brydge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contactkontey-dotcom/n8n-nodes-brydge.git"
  },
  "license": "MIT",
  "author": "BRYDGE",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsup && node scripts/copy-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BrydgeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Brydge/Brydge.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "brydge-core": "^0.1.0",
    "n8n-workflow": "^2.16.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "@types/node": "^22.20.4"
  }
}
